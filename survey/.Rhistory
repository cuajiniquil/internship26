benchmarkSys <- function(fnctn, times) {
ttaken <- rep(0,times)
for (t in 1:times) {
tstart <- Sys.time()
fnctn
tend <- Sys.time()
ttaken[t] <- tend - tstart
}
plot(ttaken)
return(ttaken)
}
