isultramfn <- function(tr) {
totdist <- get_all_distances_to_root(tr)
return(totdist < 1*10^-6) #10^-6 is the biggest specificity possible
}
isultramfn(notU)
isultramfn <- function(tr) {
totdist <- get_all_distances_to_root(tr)
return(diff(totdist) < 1*10^-6) #10^-6 is the biggest specificity possible
}
isultramfn(notU)
isultramfn <- function(tr) {
totdist <- get_all_distances_to_root(tr)
return(sum(diff(totdist)) < 1*10^-6) #10^-6 is the biggest specificity possible
}
isultramfn(notU)
#explanation in Running BEAST GUI... convo
isultramfn <- function(tr) {
totdist <- get_all_distances_to_root(tr)$distances_to_root[1:length(tree$tip.label)]
return(diff(range(totdist)) < 1*10^-6) #10^-6 is the biggest specificity possible
}
