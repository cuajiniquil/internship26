benchmarkSys <- function(fnctn, times) {
ttaken <- rep(0,times)
#+1 to avoid returning the "warmup" iteration
for (t in 1:(times+1)) {
tstart <- Sys.time()
fnctn
tend <- Sys.time()
ttaken[t] <- (tend - tstart) * 10^6
}
#plot(ttaken)
return(ttaken[2:times+1])
}
