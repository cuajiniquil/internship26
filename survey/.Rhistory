length(res[res == "in"])/length(res)
#plot:
colors <- ifelse(res == "in", "green", "red")
plot(x, y, col = colors, main = paste("Darts MC sim (nsim=",nsim,")"))
plot(res, col = colors, main = paste("Darts MC sim (nsim=",nsim,")"))
