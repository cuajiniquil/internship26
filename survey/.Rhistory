nsim <- 100000
dartsmc <- function(nsim, r) {
if (r<0) {
return(NULL);
}
x <- runif(nsim, -r,r)
y <- runif(nsim, -r,r)
dartpos <- data.frame(x = x,y = y, res = "")
for (i in 1:nsim) {
if(x[i]^2+y[i]^2<=(r^2)){
dartpos$res[i] <- "in"
}
else{
dartpos$res[i] <- "out"
}
}
return(dartpos)
}
testd <- NULL
attach(testd)
