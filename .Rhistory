colornodes <- function(nodes, color) {
geom_text2(aes(label = node, subset = node %in% nodes), hjust = -1, color = color) +
geom_point2(aes(subset = node %in% nodes), color = color, size = 3)
}
step1 <- plotpo + colornodes(c(4,5), "darkred")
step2 <- step1 + colornodes(c(9,4), "black")
colornodes <- function(nodes, color) {
list(
geom_text2(aes(label = node, subset = node %in% nodes), color = color, hjust = -1),
geom_point2(aes(subset = node %in% nodes), color = color, size = 3)
)
}
step1 <- plotpo + colornodes(c(4,5), "darkred")
step2 <- step1 + colornodes(c(9,4), "black")
