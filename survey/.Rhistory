benchmk <- function(fnctn, times) {
ttaken <- rep(0,times)
for (t in times) {
ttaken[t] <- system.time({fnctn})
}
return(summary(ttaken))
}
benchmk(is.ultrametric(rcoal(1000)),100)
benchmk <- function(fnctn, times) {
ttaken <- rep(0,times)
for (t in 1:times) {
ttaken[t] <- system.time({fnctn})
}
return(summary(ttaken))
}
