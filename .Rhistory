# create a text panel
legend_panel <- ggplot() +
annotate("text", x = 0, y = 0.8, label = "Postorder traversal",
size = 5, fontface = "bold", hjust = 0) +
annotate("point", x = 0, y = 0.5, color = "darkred", size = 4) +
annotate("text", x = 0.1, y = 0.5, label = "current node",
hjust = 0, size = 4) +
annotate("point", x = 0, y = 0.3, color = "black", size = 4) +
annotate("text", x = 0.1, y = 0.3, label = "visited node",
hjust = 0, size = 4) +
annotate("point", x = 0, y = 0.1, color = "darkgreen", size = 4) +
annotate("text", x = 0.1, y = 0.1, label = "unvisited node",
hjust = 0, size = 4) +
xlim(0, 1) + ylim(0, 1) +
theme_void()
