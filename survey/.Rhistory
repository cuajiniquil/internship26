warnings()
benchmk <- function(fnctn, times) {
ttaken <- numeric(times)
for (t in 1:times) {
ttaken[t] <- system.time({fnctn})
}
return(ttaken)
}
tstart <- Sys.time()
test <- benchmk(is.ultrametric(rcoal(1000)),100)
test
summary(test)
tend <- Sys.time()
tend - tstart
sum(test["elapsed"])
t <- numeric(times)
